{
  "name": "sharply",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "next build --webpack",
    "check": "npm run lint && npm run typecheck",
    "db:generate": "drizzle-kit generate --config=config/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=config/drizzle.config.ts",
    "db:push": "drizzle-kit push --config=config/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=config/drizzle.config.ts",
    "db:seed": "tsx scripts/seed.ts",
    "reviews:generate-fake-summary": "tsx scripts/generate-fake-review-summary.ts",
    "payload:media:migrate-to-blob": "tsx scripts/migrate-payload-media-to-blob.ts",
    "gear:list-missing-links": "tsx scripts/list-missing-links.ts",
    "raw-samples:cleanup": "tsx scripts/cleanup-deleted-raw-samples.ts",
    "constants:generate": "tsx scripts/generate-constants.ts",
    "dev": "next dev --turbo",
    "dev:e2e": "DEV_AUTH=true SKIP_ENV_VALIDATION=1 next dev --turbo -H 127.0.0.1 -p 3000",
    "e2e:bootstrap": "NODE_ENV=development tsx scripts/e2e/bootstrap-payload.ts",
    "e2e:seed-fixtures": "tsx scripts/e2e/seed-fixtures.ts",
    "e2e:setup-local": "bash scripts/e2e/setup-local.sh",
    "test:e2e:ci-local": "bash scripts/e2e/setup-local.sh --run",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache --config=prettier.config.js",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache --config=prettier.config.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prebuild": "npm run constants:generate",
    "prepare": "git config core.hooksPath .githooks || true",
    "pr:create": "npm run test:e2e && gh pr create --base development",
    "preview": "next build --webpack && next start",
    "preview:e2e": "SKIP_ENV_VALIDATION=1 next build --webpack && DEV_AUTH_PREVIEW=true SKIP_ENV_VALIDATION=1 next start -H 127.0.0.1 -p 3000",
    "start": "next start",
    "start:e2e": "DEV_AUTH=true DEV_AUTH_PREVIEW=true SKIP_ENV_VALIDATION=1 next start -H 127.0.0.1 -p 3000",
    "test": "vitest run --config=config/vitest.config.ts",
    "test:e2e": "playwright test --config=config/playwright.config.ts",
    "test:e2e:all": "PLAYWRIGHT_ALL_PROJECTS=true playwright test --config=config/playwright.config.ts",
    "test:e2e:headed": "playwright test --config=config/playwright.config.ts --headed --project=chromium",
    "test:coverage": "vitest run --coverage --config=config/vitest.config.ts",
    "test:i18n": "vitest run --config=config/vitest.config.ts tests/unit/translation-parity.test.ts",
    "test:unit": "vitest run --config=config/vitest.config.ts",
    "test:unit:watch": "vitest --config=config/vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
